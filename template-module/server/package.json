{
  "name": "@template-module/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-wasm-feature-detect.mjs",
    "dev": "tsx watch src/index.ts",
    "dev:auth": "tsx watch src/auth-gateway/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:auth": "node dist/auth-gateway/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "tsx src/db/migrate-cli.ts",
    "auth:migrate": "tsx src/auth-gateway/db/migrate-cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.5.2",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "@langchain/ollama": "^1.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.15.1",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "google-auth-library": "^11.3.4",
    "http-proxy": "^1.18.1",
    "jimp": "^0.22.12",
    "jose": "^6.2.17",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.0",
    "tesseract.js": "^5.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/http-proxy": "^1.17.17",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
