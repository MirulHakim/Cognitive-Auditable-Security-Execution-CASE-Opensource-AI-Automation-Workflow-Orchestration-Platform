# Workflow API. The auth gateway proxies here; FastAPI keeps port 8000.
PORT=8001
# Comma-separated list of allowed browser origins for the React app.
CORS_ORIGINS=http://localhost:5174

# PostgreSQL — keep credentials here, never in source.
# Create the database once with:
#   docker compose exec postgres psql -U postgres -c "CREATE DATABASE case_workflow_db;"
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/case_workflow_db
# Apply idempotent migrations on boot (set to false to run `npm run migrate` yourself).
AUTO_MIGRATE=true

# Ollama (LangChain connects to this endpoint; the model must be pulled first:
# `ollama pull qwen3.5:9b` — the CASE platform's model, matching server.py)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TEMPERATURE=0.1
OLLAMA_TIMEOUT_MS=90000

# Business-rule configuration
MAX_STEPS=20
SUPPORTED_ROLES=officer,approver,coordinator
SUPPORTED_NOTIFICATION_CHANNELS=email,telegram

# ============================================================================
# Auth gateway (separate process: `npm run dev:auth`)
# ============================================================================
AUTH_GATEWAY_PORT=8080
# The browser-facing origin. With the Vite dev proxy this is the dashboard's
# origin; the OAuth redirect URI must be registered with Google exactly.
AUTH_PUBLIC_URL=http://localhost:5174
AUTH_DASHBOARD_URL=http://localhost:5174
AUTH_GOOGLE_REDIRECT_URI=http://localhost:5174/api/auth/google/callback

# Required: generate once with `openssl rand -base64 48` (or the Node command in RUNBOOK.md).
# The gateway refuses to start while this is empty.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=case-auth-gateway
AUTH_JWT_AUDIENCE=case-platform
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: reject accounts outside one Workspace domain.
GOOGLE_HOSTED_DOMAIN=

# The Python audit API expects this workspace in X-Mock-Workspace.
AUTH_WORKSPACE_ID=6f1c2a3b-4d5e-4f60-8a7b-9c0d1e2f3a4b
# MUST resolve to the same database as DATABASE_URL: the gateway's foreign keys
# reference operators(operator_id), which the workflow API owns.
AUTH_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/case_workflow_db
AUTH_AUTO_MIGRATE=true

# Existing backends — never exposed to the browser.
LEGACY_NODE_API_URL=http://127.0.0.1:8001
FASTAPI_BASE_URL=http://127.0.0.1:8000
AUTH_FASTAPI_PREFIXES=/api/v1

AUTH_CORS_ORIGINS=http://localhost:5174
# true in production (HTTPS). Cookies are HttpOnly + SameSite=Lax either way.
AUTH_COOKIE_SECURE=false
AUTH_TRUST_PROXY=false

# Invitations are capped at 120 minutes by config AND by the database check.
AUTH_INVITATION_TTL_MINUTES=120
AUTH_APP_NAME=CASE

# ============================================================================
# Invitation email — dedicated CASE system account over standard SMTP
# ============================================================================
# Invitations are always sent by the platform, never by an admin's Gmail.
# Leave SMTP_HOST empty only for local development (see AUTH_DEV_LOG_MAGIC_LINKS).
#
# Gmail SMTP example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587          (STARTTLS)   or 465 (implicit TLS)
#   SMTP_SECURE=false      (true only for port 465)
#   SMTP_USER=noreply.yourcase@gmail.com
#   SMTP_PASS=your-16-character-app-password
#
# Gmail does NOT accept the account's normal password for SMTP. Create an
# App Password instead:
#   1. Enable 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
#   2. Open https://myaccount.google.com/apppasswords
#   3. Create an app password named "CASE Auth Gateway" (Mail / Other).
#   4. Paste the 16 characters here as SMTP_PASS (spaces are optional).
# Google Workspace admins may disable App Passwords; if the option is missing,
# use the Workspace SMTP relay (smtp-relay.gmail.com) or another provider.
#
# SMTP_PASS is a secret: keep .env out of version control and never commit it.
#
# Put this file at template-module/server/.env — `npm run dev:auth` loads it from
# the process working directory. The gateway prints the resolved path and a
# masked SMTP_PASS length at boot so you can confirm it was read.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Full SMTP protocol transcript (handshake, AUTH result, Google's numeric
# replies). Defaults to true outside production; set false to silence it.
# Credentials are redacted automatically. Turn it off once delivery works.
SMTP_DEBUG=true
# Must match SMTP_USER for Gmail; otherwise Gmail rewrites the From address.
# Default when empty: "<AUTH_APP_NAME> <SMTP_USER>".
AUTH_EMAIL_FROM=
# Optional Reply-To (a monitored mailbox, e.g. support@agency.gov.my).
AUTH_EMAIL_REPLY_TO=
# Development only: when SMTP_HOST is empty, print the magic link to the
# gateway log instead of failing the request. Never enable in production.
AUTH_DEV_LOG_MAGIC_LINKS=true
# Key material used to seal delegated Google tokens at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
# Leave empty in development to derive one from AUTH_JWT_SECRET. Set it in
# production so the two secrets can be rotated independently.
AUTH_TOKEN_ENCRYPTION_KEY=

# ============================================================================
# User-scoped integration vault (Telegram / Gmail credentials)
# ============================================================================
# Dedicated AES-256-GCM key for secrets an operator pastes into
# "Personal Integrations". Exactly 32 bytes, encoded as base64, base64url,
# 64 hex characters, or 32 raw characters. REQUIRED: the gateway refuses to
# start without it, so there is no silent fallback to the JWT secret.
# Generate once and keep it stable: rotating it makes existing vault entries
# undecryptable (they must be reconnected).
#   openssl rand -base64 32
VAULT_MASTER_KEY=

# Pre-shared key for the workflow engine's internal just-in-time decryption
# route: GET /api/internal/vault/:operator_id/:provider
# Generate: openssl rand -hex 32   (at least 32 characters)
# Leave empty to disable the internal route (it answers 503); the browser-facing
# vault endpoints keep working. Never expose this value to the browser.
VAULT_INTERNAL_API_KEY=

# Development-only bridge for the old demo identities. Leave false in production.
AUTH_ALLOW_LEGACY_IDENTITY=false
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
